# Copy to .env (backend reads backend/.env via dotenv from the working dir —
# simplest: copy this file to genesis-console/.env AND genesis-console/backend/.env, or export vars in your shell)
PORT=8787

# Comma-separated hosts you OWN or are AUTHORISED to test. If set, the checker
# refuses every other host. If empty, any public host you type is checked but
# private/loopback/metadata IPs are still blocked.
ALLOWLIST=example.com

# Tor SOCKS proxy (Tor Browser: 127.0.0.1:9150, tor daemon: 127.0.0.1:9050)
TOR_SOCKS=socks5h://127.0.0.1:9050

# OPTIONAL — xAI Grok voice. Without it, Web Speech v0.0.1 is the active engine.
# Never commit a real key.
XAI_API_KEY=
[SECURITY_DATA]
XAI_VOICE_MODEL=grok-voice
XAI_VOICE=alloy
